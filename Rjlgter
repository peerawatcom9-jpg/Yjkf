-- รับคำถามและตอบกลับ
local function AskAI(question)
    question = string.lower(question)
    local answer = AIResponses.default
    for q, a in pairs(AIResponses) do
        if q ~= "default" and string.find(question, string.lower(q)) then
            answer = a; break
        end
    end
    return answer
end

-- ส่งข้อความ
local function SendMessage()
    local text = InputBox.Text
    if text == "" or text == InputBox.PlaceholderText then return end
    AddMessage("คุณ", text, Color3.fromRGB(60, 90, 180))
    InputBox.Text = ""
    task.wait(0.5)
    AddMessage("🤖 AI", AskAI(text), Color3.fromRGB(40, 160, 120))
end

